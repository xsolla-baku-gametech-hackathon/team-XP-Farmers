HOST=127.0.0.1
PORT=8787
PUBLIC_URL=http://localhost:8787

# Configure any or all three platforms. Kick needs a public HTTPS origin.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Required in production. Empty DATA_FILE keeps development sessions in memory.
DATA_FILE=
# Private 64-character hexadecimal key. See docs/DEPLOYMENT.md.
SESSION_SECRET=
